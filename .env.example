# Copie este arquivo para .env.local e preencha.

# URL final do site (usada em SEO, sitemap e dados estruturados)
NEXT_PUBLIC_SITE_URL=https://www.suaclinica.com.br

# Rastreamento (carregados somente após o aceite de cookies - LGPD)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Destino do formulário (Formspree, Make, Zapier ou Google Apps Script que grava em planilha/e-mail)
FORM_WEBHOOK_URL=https://hooks.exemplo.com/seu-webhook
